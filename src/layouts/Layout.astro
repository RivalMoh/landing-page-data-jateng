---
// Import the Tailwind v4 CSS
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id" class="md:snap-y snap-mandatory scroll-pt-20 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portal Data Terpadu Provinsi Jawa Tengah — Akses data terbuka, satu data, dan satu peta Jawa Tengah."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Ekosistem Data Jateng</title>
  </head>
  <body
    class="bg-white text-text-body font-sans antialiased selection:bg-orange-primary selection:text-white"
  >
    <slot />
    <script>
      // Wait for the DOM to be fully loaded
      document.addEventListener("DOMContentLoaded", () => {
        // Configure the radar: trigger when 15% of the element is visible
        const observerOptions = {
          root: null,
          rootMargin: "0px",
          threshold: 0.15,
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Add the class to animate it
              entry.target.classList.add("is-visible");

              // Optional: Stop observing once it has animated so it doesn't repeat every scroll
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        // Find all elements with the 'reveal-up' class and watch them
        const revealElements = document.querySelectorAll(".reveal-up");
        revealElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
