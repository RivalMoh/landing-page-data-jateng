---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import TentangSection from "../components/TentangSection.astro";
import GatewaySection from "../components/GatewaySection.astro";
import Footer from "../components/Footer.astro";

import openDataImg from "../assets/images/open-data.png";
import satuDataImg from "../assets/images/satu-data.png";
import satuPetaImg from "../assets/images/satu-peta.png";
---

<Layout title="">
  <Navbar />
  <main>
    <Hero />
    <TentangSection />

    <GatewaySection
      id="open-data"
      title="Open Data Jateng"
      description="Portal data terbuka Provinsi Jawa Tengah yang menyediakan akses publik terhadap ribuan dataset dari berbagai sektor. Mendorong inovasi, riset, dan partisipasi masyarakat melalui keterbukaan informasi pemerintah daerah."
      buttonText="Cari Data"
      buttonUrl="https://data.jatengprov.go.id"
      theme="orange"
      image={openDataImg}
      stats={[
        { value: "1,450+", label: "Jumlah Dataset" },
        { value: "1.2M", label: "Akses Publik" },
      ]}
    />

    <GatewaySection
      id="satu-data"
      title="Satu Data Jateng"
      description="Platform interoperabilitas data antar Organisasi Perangkat Daerah se-Jawa Tengah. Menyatukan standar data, metadata, dan mekanisme berbagi data untuk mendukung perencanaan dan evaluasi pembangunan yang akurat dan terkoordinasi."
      buttonText="Akses Data"
      buttonUrl="https://satudata.jatengprov.go.id"
      theme="blue"
      isReversed={true}
      image={satuDataImg}
      stats={[
        { value: "1,450+", label: "Total Dataset" },
        { value: "85", label: "Jumlah OPD" },
        { value: "1000", label: "Dataset Terpublikasi"}
      ]}
    />

    <GatewaySection
      id="satu-peta"
      title="Satu Peta Jateng"
      description="Portal geospasial terpadu yang menyajikan peta digital interaktif Provinsi Jawa Tengah. Menyediakan data spasial tematik untuk perencanaan tata ruang, infrastruktur, lingkungan, dan analisis potensi wilayah."
      buttonText="Lihat Peta"
      buttonUrl="https://satupeta.jatengprov.go.id"
      theme="green"
      image={satuPetaImg}
      stats={[
        { value: "31", label: "Produsen Data" },
        { value: "70", label: "Dataset Terpublikasi" },
      ]}
    />

    <Footer />
  </main>
</Layout>
