---
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
  theme: "orange" | "blue" | "green";
  isReversed?: boolean;
  image: any;
  stats?: { value: string; label: string }[];
}

const {
  id,
  title,
  description,
  buttonText,
  buttonUrl,
  theme,
  isReversed = false,
  image,
  stats = [],
} = Astro.props;

// Theme mapping — all white-based, no dark backgrounds
const themeMap = {
  orange: {
    sectionBg: "bg-white",
    textPrimary: "text-text-primary",
    textBody: "text-text-body",
    button:
      "bg-orange-primary text-white hover:bg-orange-dark shadow-orange-primary/20",
    accentText: "text-orange-primary",
    statBg: "bg-white",
    statBorder: "border-orange-border/50",
  },
  blue: {
    sectionBg: "bg-surface",
    textPrimary: "text-text-primary",
    textBody: "text-text-body",
    button:
      "bg-blue-primary text-white hover:opacity-90 shadow-blue-primary/20",
    accentText: "text-blue-primary",
    statBg: "bg-white",
    statBorder: "border-blue-border/50",
  },
  green: {
    sectionBg: "bg-white",
    textPrimary: "text-text-primary",
    textBody: "text-text-body",
    button:
      "bg-green-primary text-white hover:bg-green-dark shadow-green-primary/20",
    accentText: "text-green-primary",
    statBg: "bg-white",
    statBorder: "border-green-border/50",
  },
};

const activeTheme = themeMap[theme];
---

<section
  id={id}
  class={`relative min-h-screen flex items-center py-24 snap-start ${activeTheme.sectionBg} transition-colors duration-500`}
>
  <div
    class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
  >
    <!-- Text Column -->
    <div
      class={`reveal-up flex flex-col items-start gap-6 ${isReversed ? "lg:order-last" : ""}`}
    >
      <h2
        class={`font-heading font-bold text-4xl lg:text-5xl leading-tight ${activeTheme.textPrimary}`}
      >
        {title}
      </h2>
      <p class={`text-lg leading-relaxed max-w-lg ${activeTheme.textBody}`}>
        {description}
      </p>

      {
        stats.length > 0 && (
          <div class="w-full grid grid-cols-3 gap-3 md:gap-4 mt-2">
            {stats.slice(0, 3).map((stat, i) => (
              <div
                class={`p-4 rounded-2xl border ${activeTheme.statBg} ${activeTheme.statBorder} shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md`}
                style={`transition-delay: ${i * 100}ms;`}
              >
                <div
                  class={`font-heading font-extrabold text-2xl lg:text-3xl ${activeTheme.accentText}`}
                >
                  {stat.value}
                </div>
                <div
                  class={`text-sm lg:text-base mt-1 font-medium ${activeTheme.textBody}`}
                >
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        )
      }

      <a
        href={buttonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`mt-4 inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 ${activeTheme.button}`}
      >
        {buttonText}
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>

    <!-- Image Column -->
    <div
      class={`reveal-up w-[100%] rounded-3xl overflow-hidden flex items-center justify-center p-6 lg:p-8`}
      style="transition-delay: 200ms;"
    >
      <Image
        src={image}
        alt={`Visual ${title}`}
        class="w-[100%] h-[100%] object-contain drop-shadow-xl transition-transform duration-500 hover:scale-105"
      />
    </div>
  </div>
</section>
