---
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
  theme: "orange" | "blue" | "green";
  isReversed?: boolean; // Controls the Z-pattern (Image left vs Image right)
  image: any;
  stats?: { value: string; label: string }[];
}

const {
  id,
  title,
  description,
  buttonText,
  buttonUrl,
  theme,
  isReversed = false,
  image,
  stats = [],
} = Astro.props;

// Rigorous Theme Mapping based on your Figma design tokens
const themeMap = {
  orange: {
    sectionBg: "bg-white",
    textPrimary: "text-text-primary",
    textBody: "text-text-body",
    button:
      "bg-orange-primary text-white hover:bg-orange-dark shadow-orange-primary/25",
    imageBg: "bg-orange-light",
    imageBorder: "border-orange-border",
    accentText: "text-orange-dark",
    statBg: "color-white",
    statBorder: "border-orange-100",
  },
  blue: {
    sectionBg: "bg-surface",
    textPrimary: "text-text-primary",
    textBody: "text-text-body",
    button:
      "bg-blue-primary text-white hover:opacity-90 shadow-blue-primary/25",
    imageBg: "bg-blue-light",
    imageBorder: "border-blue-border",
    accentText: "text-blue-primary",
    statBg: "color-white",
    statBorder: "border-blue-100",
  },
  green: {
    // Specifically handling your dark mode section for Satu Peta
    sectionBg: "bg-green-dark-bg",
    textPrimary: "text-white",
    textBody: "text-text-muted",
    button:
      "bg-green-primary text-white hover:opacity-90 shadow-green-primary/25",
    imageBg: "bg-green-card-bg",
    imageBorder: "border-white/10",
    accentText: "text-green-primary",
    statBg: "color-white",
    statBorder: "border-green-100",
  },
};

const activeTheme = themeMap[theme];
---

<section
  id={id}
  class={`relative h-screen flex items-center pt-20 snap-start ${activeTheme.sectionBg} transition-colors duration-500`}
>
  <div
    class="max-w-7xl mx-auto px-6 lg:px-8 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
  >
    <div
      class={`reveal-up flex flex-col items-start gap-6 ${isReversed ? "lg:order-last" : ""}`}
    >
      <h2
        class={`font-heading font-bold text-4xl lg:text-5xl ${activeTheme.textPrimary}`}
      >
        {title}
      </h2>
      <p class={`text-lg leading-relaxed ${activeTheme.textBody}`}>
        {description}
      </p>

      {
        stats.length > 0 && (
          <div class="w-full grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-2 mb-2">
            {/* We use .slice(0, 3) to strictly enforce the maximum of 3 cards */}
            {stats.slice(0, 3).map((stat) => (
              <div
                class={`p-4 rounded-2xl border ${activeTheme.statBg} ${activeTheme.statBorder} transition-transform duration-300 hover:-translate-y-1`}
              >
                <div
                  class={`font-heading font-extrabold text-2xl lg:text-3xl ${activeTheme.accentText}`}
                >
                  {stat.value}
                </div>
                <div
                  class={`text-sm lg:text-base mt-1 font-medium ${activeTheme.textBody}`}
                >
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        )
      }

      <a
        href={buttonUrl}
        class={`mt-4 px-8 py-3 rounded-full font-semibold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 ${activeTheme.button}`}
      >
        {buttonText}
      </a>
    </div>

    <div
      class={`reveal-up w-full h-full rounded-3xl overflow-hidden flex items-center justify-center py-12 lg:py-0`}
      style="transition-delay: 200ms;"
    >
      <Image
        src={image}
        alt={`Visual ${title}`}
        class="w-[100%] h-[100%] object-contain drop-shadow-2xl transition-transform duration-500 hover:scale-105"
      />
    </div>
  </div>
</section>
