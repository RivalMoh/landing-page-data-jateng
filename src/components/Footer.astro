---

---

<footer class="bg-footer-bg border-t border-border-ui py-16 snap-start">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Brand Column -->
      <div class="flex flex-col gap-4 lg:col-span-1">
        <div class="flex items-center gap-3">
          <div
            class="w-10 h-10 rounded-full bg-gray-300 shrink-0"
          >
          </div>
          <span class="font-heading font-bold text-lg text-text-primary">
            Ekosistem Data Jateng
          </span>
        </div>
        <p class="text-sm text-text-muted leading-relaxed">
          Portal data terpadu Provinsi Jawa Tengah untuk mendukung transparansi
          dan tata kelola pemerintahan berbasis data.
        </p>
      </div>

      <!-- Portal Links -->
      <div class="flex flex-col gap-3">
        <h4 class="font-heading font-semibold text-text-primary text-sm uppercase tracking-wider">
          Portal
        </h4>
        <div class="flex flex-col gap-2">
          <a
            href="https://data.jatengprov.go.id"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-text-body hover:text-orange-primary transition-colors duration-300"
          >
            Open Data Jateng
          </a>
          <a
            href="https://satudata.jatengprov.go.id"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-text-body hover:text-blue-primary transition-colors duration-300"
          >
            Satu Data Jateng
          </a>
          <a
            href="https://satupeta.jatengprov.go.id"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-text-body hover:text-green-primary transition-colors duration-300"
          >
            Satu Peta Jateng
          </a>
        </div>
      </div>

      <!-- Informasi -->
      <div class="flex flex-col gap-3">
        <h4 class="font-heading font-semibold text-text-primary text-sm uppercase tracking-wider">
          Informasi
        </h4>
        <div class="flex flex-col gap-2">
          <a
            href="#"
            class="text-sm text-text-body hover:text-text-primary transition-colors duration-300"
          >
            Tentang Kami
          </a>
          <a
            href="#"
            class="text-sm text-text-body hover:text-text-primary transition-colors duration-300"
          >
            Kebijakan Privasi
          </a>
          <a
            href="#"
            class="text-sm text-text-body hover:text-text-primary transition-colors duration-300"
          >
            Syarat & Ketentuan
          </a>
          <a
            href="#"
            class="text-sm text-text-body hover:text-text-primary transition-colors duration-300"
          >
            FAQ
          </a>
        </div>
      </div>

      <!-- Kontak -->
      <div class="flex flex-col gap-3">
        <h4 class="font-heading font-semibold text-text-primary text-sm uppercase tracking-wider">
          Kontak
        </h4>
        <div class="flex flex-col gap-2">
          <a
            href="mailto:data@jatengprov.go.id"
            class="text-sm text-text-body hover:text-text-primary transition-colors duration-300"
          >
            data@jatengprov.go.id
          </a>
          <p class="text-sm text-text-muted leading-relaxed">
            Dinas Komunikasi dan Informatika<br />
            Provinsi Jawa Tengah
          </p>
        </div>
      </div>
    </div>

    <!-- Divider + Copyright -->
    <div class="mt-12 pt-8 border-t border-border-ui">
      <p class="text-sm text-text-muted text-center">
        Copyright &copy; 2026 Ekosistem Data Jateng. All rights reserved.
      </p>
    </div>
  </div>
</footer>
